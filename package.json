{
  "name": "@yangodev/wechat-publisher",
  "version": "0.4.0",
  "description": "从已渲染文章包创建微信公众号草稿的本地 CLI。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangodev/wechat-publisher.git"
  },
  "homepage": "https://github.com/yangodev/wechat-publisher#readme",
  "bugs": {
    "url": "https://github.com/yangodev/wechat-publisher/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wechat-publisher": "dist/publisher-cli.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "TRADEMARKS.md",
    "wechat-publisher.config.example.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/publisher-cli.ts",
    "dev:publisher": "tsx src/publisher-cli.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "pack:cli": "node scripts/pack-cli.mjs",
    "smoke:diagnostics": "node scripts/diagnostics-smoke.mjs",
    "smoke:doctor": "node scripts/doctor-smoke.mjs",
    "smoke:publisher": "node scripts/publisher-smoke.mjs",
    "fixture:draft:dry-run": "node scripts/fixture-draft-dry-run.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "domhandler": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
